{
  "name": "x-erp-et-uretim",
  "productName": "X ERP",
  "version": "1.0.0",
  "description": "Et, tavuk ve kasap ürünleri üretim, izlenebilirlik ve muhasebe yönetimi",
  "author": "X Şirketi",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "build:exe": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "vite": "latest"
  },
  "build": {
    "appId": "com.xsirketi.erp",
    "productName": "X ERP",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": { "target": ["portable"], "artifactName": "X-ERP-${version}-Windows.exe" },
    "portable": { "artifactName": "X-ERP-${version}-Windows.exe" }
  }
}
